          }
        }
      ],
      "description": "Improper SVG sanitization",
      "analysis": {
        "state": "not_affected",
        "justification": "protected_by_mitigating_control",
        "detail": "All user-provided content is HTML-escaped (escapeHtml) before it is passed to ng-bind-html / $sanitize, so attacker-controlled SVG markup never reaches the sanitizer as live markup. In addition, SVG support in $sanitize is not enabled ($sanitizeProvider.enableSvg() is never called), so SVG elements are stripped regardless. Only static, bundled SVG assets (emoji, icons) are rendered, never external or user-provided SVG.",
        "firstIssued": "2025-12-02T22:17:20Z",
        "lastUpdated": "2026-07-03T07:30:09Z"
      },
      "affects": [{ "ref": "pkg:npm/angular@1.8.3" }]
